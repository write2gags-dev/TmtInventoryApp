@model TmtInventoryApp.Models.BillingRecord

@{
    ViewData["Title"] = "Delete Billing Record";
}

<h1>Delete Billing Record</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Billing Record</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Dealer)
        </dt>
        <dd class = "col-sm-10">
            @(Model.Dealer?.Name ?? "Unknown dealer")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.BillingDate)
        </dt>
        <dd class = "col-sm-10">
            @Model.BillingDate.ToString("dd MMM yyyy")
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.InvoiceNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.InvoiceNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Notes)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Notes)
        </dd>
    </dl>
    
    <h4>Items to be Deleted</h4>
    <table class="table table-bordered">
        <thead>
            <tr>
                <th>TMT Variant</th>
                <th>Billed Weight (KG)</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items)
            {
                <tr>
                    <td>@item.TmtVariant?.DisplayName</td>
                    <td>@item.BilledWeightKg.GetValueOrDefault().ToString("N2")</td>
                </tr>
            }
        </tbody>
    </table>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
