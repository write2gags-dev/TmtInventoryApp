@using TmtInventoryApp.Models
@model IEnumerable<TmtInventoryApp.Models.BillingRecord>

@{
    ViewData["Title"] = "Billing Records";
}

<div class="container-fluid">
    <div class="row mb-3">
        <div class="col-md-6">
            <h2>Billing Records</h2>
            <p class="text-muted">Track weight billed to dealers</p>
        </div>
        <div class="col-md-6 text-end">
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Add Billing Record
            </a>
            <a asp-action="DealerStatus" class="btn btn-success">
                <i class="bi bi-graph-up"></i> Dealer Billing Status
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Dealer</th>
                        <th>Items</th>
                        <th>Total Weight</th>
                        <th>Invoice Number</th>
                        <th>Notes</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.BillingDate.ToString("dd/MM/yyyy")</td>
                            <td>@item.Dealer?.Name</td>
                            <td>
                                <ul class="list-unstyled mb-0">
                                        @foreach (var billingItem in item.Items)
                                    {
                                        <li>
                                            <small>@((billingItem.TmtVariant != null && billingItem.TmtVariant.Diameter > 0) ? billingItem.TmtVariant.Diameter + " mm" : billingItem.TmtVariant?.DisplayName): <strong>@billingItem.BilledWeightKg.GetValueOrDefault().ToString("N2") KG</strong></small>
                                        </li>
                                    }
                                </ul>
                            </td>
                            <td>
                                <strong>@item.Items.Sum(i => i.BilledWeightKg).GetValueOrDefault().ToString("N2") KG</strong>
                            </td>
                            <td>@(item.InvoiceNumber ?? "-")</td>
                            <td>@(item.Notes ?? "-")</td>
                            <td>
                                @if (Context.Session.GetString("Role") == UserRoles.Admin)
                                {
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                                }

                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
