@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
}

<div class="row g-4 mb-4">
    <!-- Total Customers -->
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                <i class="bi bi-people-fill"></i>
            </div>
            <div class="value">@ViewBag.TotalCustomers</div>
            <div class="label">Total Customers</div>
        </div>
    </div>

    <!-- Total Outstanding -->
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                <i class="bi bi-currency-rupee"></i>
            </div>
            <div class="value">₹@ViewBag.TotalOutstanding.ToString("N0")</div>
            <div class="label">Total Outstanding</div>
        </div>
    </div>

    <!-- Inventory Value -->
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <div class="value">₹@ViewBag.TotalInventoryValue.ToString("N0")</div>
            <div class="label">Inventory Value</div>
        </div>
    </div>

    <!-- Low Stock Items -->
    <div class="col-md-3">
        <div class="stat-card">
            <div class="icon" style="background: linear-gradient(135deg, #fa709a 0%, #fee140 100%); color: white;">
                <i class="bi bi-exclamation-triangle-fill"></i>
            </div>
            <div class="value">@ViewBag.LowStockItems.Count</div>
            <div class="label">Low Stock Alerts</div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Sales -->
    <div class="col-lg-8">
        <div class="table-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="mb-0"><i class="bi bi-cart-check me-2"></i>Recent Sales</h5>
                <a href="/DealerPortal/Sales" class="btn btn-sm btn-primary-gradient">
                    View All <i class="bi bi-arrow-right ms-1"></i>
                </a>
            </div>

            @if (ViewBag.RecentSales != null && ViewBag.RecentSales.Count > 0)
            {
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Customer</th>
                                <th>Invoice</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in ViewBag.RecentSales)
                            {
                                <tr>
                                    <td>@sale.SaleDate.ToString("dd MMM yyyy")</td>
                                    <td>@sale.EndCustomer?.Name</td>
                                    <td>@(sale.InvoiceNumber ?? $"Sale #{sale.Id}")</td>
                                    <td><strong>₹@sale.TotalAmount.ToString("N2")</strong></td>
                                    <td>
                                        @if (sale.PaymentStatus == "Paid")
                                        {
                                            <span class="badge bg-success">Paid</span>
                                        }
                                        else if (sale.PaymentStatus == "Partial")
                                        {
                                            <span class="badge bg-warning">Partial</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-inbox" style="font-size: 48px;"></i>
                    <p class="mt-3">No recent sales</p>
                </div>
            }
        </div>
    </div>

    <!-- Pending Payments -->
    <div class="col-lg-4">
        <div class="table-card">
            <h5 class="mb-3"><i class="bi bi-clock-history me-2"></i>Pending Payments</h5>

            @if (ViewBag.PendingPayments != null && ViewBag.PendingPayments.Count > 0)
            {
                <div class="list-group list-group-flush">
                    @foreach (var payment in ViewBag.PendingPayments)
                    {
                        <div class="list-group-item px-0">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h6 class="mb-1">@payment.EndCustomer?.Name</h6>
                                    <small class="text-muted">@payment.SaleDate.ToString("dd MMM yyyy")</small>
                                </div>
                                <span class="badge bg-danger">₹@payment.OutstandingAmount.ToString("N0")</span>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-check-circle" style="font-size: 36px;"></i>
                    <p class="mt-2 mb-0">All payments cleared!</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Low Stock Alerts -->
@if (ViewBag.LowStockItems != null && ViewBag.LowStockItems.Count > 0)
{
    <div class="row g-4 mt-2">
        <div class="col-12">
            <div class="table-card">
                <h5 class="mb-3">
                    <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>
                    Low Stock Alerts
                </h5>

                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Product Category</th>
                                <th>Brand</th>
                                <th>Current Stock</th>
                                <th>Minimum Level</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in ViewBag.LowStockItems)
                            {
                                <tr>
                                    <td>@item.ProductBrand?.ProductCategory?.Name</td>
                                    <td>@item.ProductBrand?.Name</td>
                                    <td><span class="badge bg-danger">@item.CurrentQuantity @item.ProductBrand?.ProductCategory?.UnitOfMeasurement</span></td>
                                    <td>@item.MinimumStockLevel @item.ProductBrand?.ProductCategory?.UnitOfMeasurement</td>
                                    <td>
                                        <a href="/DealerPortal/DealerInventory/AddStock" class="btn btn-sm btn-primary-gradient">
                                            <i class="bi bi-plus-circle me-1"></i>Add Stock
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

<div class="row g-4 mt-2">
    <div class="col-12">
        <div class="text-center">
            <a href="/DealerPortal/Sales/Create" class="btn btn-lg btn-primary-gradient me-2">
                <i class="bi bi-plus-circle me-2"></i>New Sale
            </a>
            <a href="/DealerPortal/DealerInventory/AddStock" class="btn btn-lg btn-outline-primary">
                <i class="bi bi-box-arrow-in-down me-2"></i>Add Stock
            </a>
        </div>
    </div>
</div>
