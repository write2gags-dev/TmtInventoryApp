@model IEnumerable<TmtInventoryApp.Models.DealerPortal.ProductBrand>

@{
    ViewData["Title"] = "Add Stock";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
    var brands = ViewBag.ProductBrands as List<TmtInventoryApp.Models.DealerPortal.ProductBrand>;
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card stat-card">
            <div class="card-body p-4">
                <h4 class="card-title mb-4">Add New Stock</h4>
                
                <form asp-action="AddStock" method="post">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Select Product</label>
                        <select name="productBrandId" class="form-select form-select-lg" required>
                            <option value="">-- Choose a Product --</option>
                            @if (brands != null)
                            {
                                var groupedBrands = brands.GroupBy(b => b.ProductCategory?.Name);
                                foreach (var group in groupedBrands)
                                {
                                    <optgroup label="@group.Key">
                                        @foreach (var brand in group)
                                        {
                                            <option value="@brand.Id">@brand.Name</option>
                                        }
                                    </optgroup>
                                }
                            }
                        </select>
                    </div>

                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Quantity to Add</label>
                            <input type="number" step="0.01" name="quantity" class="form-control form-control-lg" required min="0.01" placeholder="0.00" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Reference Number</label>
                            <input type="text" name="referenceNumber" class="form-control form-control-lg" placeholder="e.g. Invoice #" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Notes</label>
                        <textarea name="notes" class="form-control" rows="3" placeholder="Additional details..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary-gradient btn-lg">Add Stock</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
