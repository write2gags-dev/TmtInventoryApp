@model TmtInventoryApp.Models.DealerPortal.DealerInventoryItem

@{
    ViewData["Title"] = "Adjust Stock";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card stat-card">
            <div class="card-body p-4">
                <h4 class="card-title mb-4">Adjust Stock Level</h4>
                <div class="alert alert-info">
                    <strong>Product:</strong> @Model.ProductBrand?.ProductCategory?.Name - @Model.ProductBrand?.Name
                </div>

                <form asp-action="AdjustStock" method="post">
                    <input type="hidden" name="id" value="@Model.Id" />

                    <div class="mb-3">
                        <label class="form-label text-muted">Current Quantity</label>
                        <div class="fw-bold fs-4">@Model.CurrentQuantity @Model.ProductBrand?.ProductCategory?.UnitOfMeasurement</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-bold">New Correct Quantity</label>
                        <input type="number" step="0.01" name="newQuantity" class="form-control form-control-lg" required value="@Model.CurrentQuantity" />
                        <div class="form-text">Enter the actual physical quantity available.</div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Reason for Adjustment</label>
                        <textarea name="notes" class="form-control" rows="3" required placeholder="e.g. Audit correction, Damaged stock..."></textarea>
                    </div>

                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-warning text-white btn-lg">Confirm Adjustment</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
