@{
    ViewData["Title"] = "Dealer Portal Setup";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-gear-fill me-2"></i>
                        Dealer Portal Setup
                    </h4>
                </div>
                <div class="card-body">
                    <p class="text-muted">
                        Create portal access for dealers to manage their own inventory, customers, and sales.
                    </p>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            @TempData["Success"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i>
                            @TempData["Error"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <a href="@Url.Action("ViewUsers")" class="btn btn-info">
                            <i class="bi bi-people-fill me-2"></i>
                            View All Dealer Users
                        </a>
                        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#registerSubscriberModal">
                            <i class="bi bi-person-plus-fill me-2"></i>
                            Register New Subscriber
                        </button>
                    </div>

                    <h5 class="mb-3">Create Dealer Portal Access</h5>

                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Dealer ID</th>
                                    <th>Dealer Name</th>
                                    <th>Category</th>
                                    <th>Portal Access</th>
                                    <th>Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dealer in ViewBag.Dealers)
                                {
                                    <tr>
                                        <td>@dealer.Id</td>
                                        <td><strong>@dealer.Name</strong></td>
                                        <td>
                                            @if(dealer.Category == "Portal Subscriber")
                                            {
                                                <span class="badge bg-info text-dark">@dealer.Category</span>
                                            }
                                            else
                                            {
                                                @dealer.Category
                                            }
                                        </td>
                                        <td>
                                            @if (dealer.HasPortalAccess)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-check-circle me-1"></i>Enabled
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">
                                                    <i class="bi bi-x-circle me-1"></i>Not Enabled
                                                </span>
                                            }
                                        </td>
                                        <td>
                                            @if (!dealer.HasPortalAccess)
                                            {
                                                <button type="button" class="btn btn-sm btn-primary" 
                                                        data-bs-toggle="modal" 
                                                        data-bs-target="#createUserModal"
                                                        data-dealer-id="@dealer.Id"
                                                        data-dealer-name="@dealer.Name">
                                                    <i class="bi bi-plus-circle me-1"></i>Create Access
                                                </button>
                                            }
                                            else
                                            {
                                                <span class="text-success">
                                                    <i class="bi bi-check-lg"></i> Already configured
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Register Subscriber Modal -->
<div class="modal fade" id="registerSubscriberModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="RegisterSubscriber">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Register New Subscriber</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p class="text-muted small">
                        Add a new dealer exclusively for the Portal. They will be categorized as "Portal Subscriber".
                    </p>

                    <div class="mb-3">
                        <label for="subscriberName" class="form-label">Business/Dealer Name</label>
                        <input type="text" class="form-control" id="subscriberName" name="name" required 
                               placeholder="e.g. New Age Traders" />
                    </div>

                    <div class="mb-3">
                        <label for="contactPerson" class="form-label">Contact Person</label>
                        <input type="text" class="form-control" id="contactPerson" name="contactPerson" required 
                               placeholder="e.g. Rahul Kumar" />
                    </div>
                    
                    <div class="mb-3">
                        <label for="phoneNumber" class="form-label">Phone Number</label>
                        <input type="tel" class="form-control" id="phoneNumber" name="phoneNumber" required 
                               placeholder="10-digit mobile number" />
                    </div>

                    <hr />

                    <div class="mb-3">
                        <label for="subUsername" class="form-label">Portal Username</label>
                        <input type="text" class="form-control" id="subUsername" name="username" required 
                               placeholder="Username for login" />
                    </div>

                    <div class="mb-3">
                        <label for="subPassword" class="form-label">Portal Password</label>
                        <input type="password" class="form-control" id="subPassword" name="password" required 
                               placeholder="Password" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-person-plus-fill me-1"></i>Register Subscriber
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Create User Modal -->
<div class="modal fade" id="createUserModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-action="CreateUser">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title">Create Dealer Portal Access</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="dealerId" name="dealerId" />
                    
                    <div class="mb-3">
                        <label class="form-label">Dealer</label>
                        <input type="text" id="dealerName" class="form-control" readonly />
                    </div>

                    <div class="mb-3">
                        <label for="username" class="form-label">Username</label>
                        <input type="text" class="form-control" id="username" name="username" required 
                               placeholder="Enter username for dealer login" />
                        <small class="text-muted">This will be used to login to the dealer portal</small>
                    </div>

                    <div class="mb-3">
                        <label for="password" class="form-label">Password</label>
                        <input type="password" class="form-control" id="password" name="password" required 
                               placeholder="Enter password" />
                        <small class="text-muted">Minimum 6 characters recommended</small>
                    </div>

                    <div class="alert alert-info">
                        <i class="bi bi-info-circle me-2"></i>
                        <strong>Note:</strong> Share these credentials securely with the dealer. They can access the portal at:
                        <code>/DealerPortal/DealerAuth/Login</code>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-plus-circle me-1"></i>Create Access
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Populate modal with dealer information
        var createUserModal = document.getElementById('createUserModal');
        createUserModal.addEventListener('show.bs.modal', function (event) {
            var button = event.relatedTarget;
            var dealerId = button.getAttribute('data-dealer-id');
            var dealerName = button.getAttribute('data-dealer-name');

            document.getElementById('dealerId').value = dealerId;
            document.getElementById('dealerName').value = dealerName;
            
            // Suggest username based on dealer name
            var suggestedUsername = dealerName.toLowerCase().replace(/\s+/g, '');
            document.getElementById('username').value = suggestedUsername;
        });
    </script>
}
