@model TmtInventoryApp.Models.DealerPortal.CustomerSale
@using System.Text.Json;

@{
    ViewData["Title"] = "New Sale";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";

    var productBrands = ViewBag.ProductBrands as List<TmtInventoryApp.Models.DealerPortal.ProductBrand>;
    var inventoryData = ViewBag.InventoryItems as Dictionary<int, decimal>;
    
    // Create a simplified list for JS
    var productMeta = productBrands.Select(pb => new {
        id = pb.Id,
        category = pb.ProductCategory.Name,
        unit = pb.ProductCategory.UnitOfMeasurement,
        stock = inventoryData.ContainsKey(pb.Id) ? inventoryData[pb.Id] : 0
    });
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title">New Sale</h2>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<form asp-action="Create" id="saleForm">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">Customer Details</h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label required">Customer Name</label>
                    <input type="text" name="customerName" class="form-control" placeholder="Enter customer name" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">Phone Number</label>
                    <input type="text" name="customerPhone" class="form-control" placeholder="Enter phone number" />
                    <div class="form-text">System will auto-link if phone exists</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Address</label>
                    <input type="text" name="customerAddress" class="form-control" placeholder="Enter address" />
                </div>
                 <div class="col-md-6 mb-3">
                    <label asp-for="InvoiceNumber" class="form-label">Invoice Number</label>
                    <input asp-for="InvoiceNumber" class="form-control" placeholder="Auto-generated if empty" />
                    <span asp-validation-for="InvoiceNumber" class="text-danger"></span>
                </div>
            </div>
             <div class="mb-3">
                <label asp-for="Notes" class="form-label">Notes</label>
                <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light d-flex justify-content-between align-items-center">
            <h5 class="card-title mb-0">Items</h5>
            <button type="button" class="btn btn-sm btn-primary" id="addItemBtn">
                <i class="bi bi-plus-lg me-1"></i>Add Item
            </button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-bordered mb-0" id="itemsTable">
                    <thead class="bg-light">
                        <tr>
                            <th style="width: 35%;">Product</th>
                            <th style="width: 15%;">Stock</th>
                            <th style="width: 15%;">Quantity</th>
                            <th style="width: 15%;">Price/Unit</th>
                            <th style="width: 15%;">Total</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="itemsList">
                        <!-- Items will be added here via JS -->
                    </tbody>
                    <tfoot class="fw-bold">
                        <tr>
                            <td colspan="4" class="text-end">Grand Total:</td>
                            <td id="grandTotal">0.00</td>
                            <td></td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>

    <div class="card mb-4">
        <div class="card-header bg-light">
            <h5 class="card-title mb-0">Payment Details</h5>
        </div>
        <div class="card-body">
            <div class="row align-items-end">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Total Amount</label>
                    <input type="text" class="form-control fw-bold" id="displayTotal" readonly value="0.00" />
                </div>
                <div class="col-md-4 mb-3">
                    <label class="form-label">Amount Paid Now</label>
                     <div class="input-group">
                        <span class="input-group-text">₹</span>
                        <input type="number" name="initialPaidAmount" id="initialPaid" class="form-control" step="0.01" min="0" value="0" />
                    </div>
                </div>
                 <div class="col-md-4 mb-3">
                    <label class="form-label">Remaining Balance</label>
                    <input type="text" class="form-control text-danger fw-bold" id="remainingBalance" readonly value="0.00" />
                </div>
            </div>
        </div>
    </div>

    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
        <button type="submit" class="btn btn-primary-gradient px-4">Create Sale</button>
    </div>
</form>

<template id="itemRowTemplate">
    <tr class="item-row">
        <td>
            <select name="Items[{index}].ProductBrandId" class="form-select product-select" required>
                <option value="">-- Select Product --</option>
                @foreach (var category in productBrands.GroupBy(x => x.ProductCategory.Name))
                {
                    <optgroup label="@category.Key">
                        @foreach (var brand in category)
                        {
                            <option value="@brand.Id">@brand.Name</option>
                        }
                    </optgroup>
                }
            </select>
        </td>
        <td>
            <div class="stock-display text-muted small"></div>
            <input type="hidden" class="stock-val" />
        </td>
        <td>
            <div class="input-group input-group-sm">
                <input type="number" name="Items[{index}].Quantity" class="form-control qty-input" step="0.01" min="0.01" required />
                <span class="input-group-text unit-label">-</span>
            </div>
        </td>
        <td>
            <input type="number" name="Items[{index}].UnitPrice" class="form-control unit-price-input" step="0.01" min="0" required />
        </td>
        <td>
            <input type="text" class="form-control-plaintext row-total text-end" readonly value="0.00" />
        </td>
        <td class="text-center">
            <button type="button" class="btn btn-sm btn-outline-danger remove-row">
                <i class="bi bi-trash"></i>
            </button>
        </td>
    </tr>
</template>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        const productMeta = @Html.Raw(JsonSerializer.Serialize(productMeta));
        let itemIndex = 0;

        function addItem() {
            const template = document.getElementById('itemRowTemplate');
            const clone = template.content.cloneNode(true);
            const row = clone.querySelector('tr');
            
            row.innerHTML = row.innerHTML.replace(/{index}/g, itemIndex++);
            document.getElementById('itemsList').appendChild(row);
            
            // Attach event listeners to new row
            attachRowEvents(row);
        }

        function attachRowEvents(row) {
            const select = row.querySelector('.product-select');
            const qtyInput = row.querySelector('.qty-input');
            const priceInput = row.querySelector('.unit-price-input');
            const removeBtn = row.querySelector('.remove-row');

            select.addEventListener('change', function() {
                const brandId = parseInt(this.value);
                const meta = productMeta.find(p => p.id === brandId);
                const stockDisplay = row.querySelector('.stock-display');
                const unitLabel = row.querySelector('.unit-label');
                const stockVal = row.querySelector('.stock-val');

                if (meta) {
                    stockDisplay.textContent = `Avail: ${meta.stock} ${meta.unit}`;
                    stockVal.value = meta.stock;
                    unitLabel.textContent = meta.unit;
                    qtyInput.max = meta.stock; // Optional: enforce max based on stock
                } else {
                    stockDisplay.textContent = '';
                    stockVal.value = 0;
                    unitLabel.textContent = '-';
                    qtyInput.removeAttribute('max');
                }
            });

            qtyInput.addEventListener('input', updateRowTotal);
            priceInput.addEventListener('input', updateRowTotal);
            
            removeBtn.addEventListener('click', function() {
                row.remove();
                calculateGrandTotal();
            });
        }

        function updateRowTotal() {
            const row = this.closest('tr');
            const qty = parseFloat(row.querySelector('.qty-input').value) || 0;
            const price = parseFloat(row.querySelector('.unit-price-input').value) || 0;
            const total = qty * price;
            
            row.querySelector('.row-total').value = total.toFixed(2);
            calculateGrandTotal();
        }

        function calculateGrandTotal() {
            let total = 0;
            document.querySelectorAll('.row-total').forEach(input => {
                total += parseFloat(input.value) || 0;
            });
            document.getElementById('grandTotal').textContent = total.toFixed(2);
            document.getElementById('displayTotal').value = total.toFixed(2);
            calculateRemaining();
        }

        function calculateRemaining() {
            const total = parseFloat(document.getElementById('displayTotal').value) || 0;
            const paid = parseFloat(document.getElementById('initialPaid').value) || 0;
            const remaining = total - paid;
            document.getElementById('remainingBalance').value = remaining.toFixed(2);
        }

        document.getElementById('initialPaid').addEventListener('input', calculateRemaining);

        document.getElementById('addItemBtn').addEventListener('click', addItem);

        // Add initial row
        addItem();
    </script>
}
