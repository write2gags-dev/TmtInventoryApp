@model TmtInventoryApp.Models.DealerPortal.CustomerSale

@{
    ViewData["Title"] = "Sale Details";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title">Sale Details</h2>
        <div class="text-muted">Invoice #@Model.InvoiceNumber</div>
    </div>
    <div class="col-auto">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
        <a href="#" class="btn btn-secondary ms-2" onclick="window.print()">
            <i class="bi bi-printer me-2"></i>Print
        </a>
    </div>
</div>

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Items</h5>
            </div>
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="text-center">Quantity</th>
                            <th class="text-end">Unit Price</th>
                            <th class="text-end">Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr>
                                <td>
                                    <div class="fw-bold">@item.ProductBrand?.Name</div>
                                    <small class="text-muted">@item.ProductBrand?.ProductCategory?.Name</small>
                                </td>
                                <td class="text-center">
                                    @item.Quantity.ToString("0.##") @item.ProductBrand?.ProductCategory?.UnitOfMeasurement
                                </td>
                                <td class="text-end">@item.UnitPrice.ToString("C2")</td>
                                <td class="text-end">@item.FinalAmount.ToString("C2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="bg-light fw-bold">
                        <tr>
                            <td colspan="3" class="text-end">Total Amount:</td>
                            <td class="text-end">@Model.TotalAmount.ToString("C2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end text-success">Paid Amount:</td>
                            <td class="text-end text-success">@Model.PaidAmount.ToString("C2")</td>
                        </tr>
                        <tr>
                            <td colspan="3" class="text-end text-danger">Balance Due:</td>
                            <td class="text-end text-danger">@Model.OutstandingAmount.ToString("C2")</td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Customer Info</h5>
            </div>
            <div class="card-body">
                <h5 class="mb-1">@Model.EndCustomer?.Name</h5>
                @if (!string.IsNullOrEmpty(Model.EndCustomer?.PhoneNumber))
                {
                    <p class="text-muted mb-2"><i class="bi bi-telephone me-2"></i>@Model.EndCustomer?.PhoneNumber</p>
                }
                @if (!string.IsNullOrEmpty(Model.EndCustomer?.Address))
                {
                    <p class="text-muted mb-0"><i class="bi bi-geo-alt me-2"></i>@Model.EndCustomer?.Address</p>
                }
            </div>
            <div class="card-footer bg-white border-top-0">
                <div class="d-grid">
                    <a asp-controller="Customer" asp-action="Ledger" asp-route-id="@Model.EndCustomerId" class="btn btn-outline-primary btn-sm">
                        View Ledger
                    </a>
                </div>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Payment Status</h5>
            </div>
            <div class="card-body text-center">
                @if (Model.PaymentStatus == TmtInventoryApp.Models.DealerPortal.PaymentStatus.Paid)
                {
                    <div class="display-6 text-success mb-2"><i class="bi bi-check-circle-fill"></i></div>
                    <h5 class="text-success">Fully Paid</h5>
                }
                else if (Model.PaymentStatus == TmtInventoryApp.Models.DealerPortal.PaymentStatus.Partial)
                {
                    <div class="display-6 text-warning mb-2"><i class="bi bi-pie-chart-fill"></i></div>
                    <h5 class="text-warning">Partially Paid</h5>
                    <p class="mb-3">Start collecting the remaining balance.</p>
                    <a asp-action="RecordPayment" asp-route-id="@Model.Id" class="btn btn-primary-gradient w-100">
                        Record Payment
                    </a>
                }
                else
                {
                     <div class="display-6 text-danger mb-2"><i class="bi bi-exclamation-circle-fill"></i></div>
                    <h5 class="text-danger">Payment Pending</h5>
                    <p class="mb-3">No payment has been received yet.</p>
                    <a asp-action="RecordPayment" asp-route-id="@Model.Id" class="btn btn-primary-gradient w-100">
                        Record Payment
                    </a>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">Sale Info</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Date:</span>
                    <span class="fw-bold">@Model.SaleDate.ToString("dd MMM yyyy")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Created By:</span>
                    <span>@Model.CreatedBy</span>
                </div>
                 @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mt-3">
                        <span class="text-muted d-block mb-1">Notes:</span>
                        <p class="small bg-light p-2 rounded mb-0">@Model.Notes</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
