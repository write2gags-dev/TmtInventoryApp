@model IEnumerable<TmtInventoryApp.Models.DealerPortal.CustomerSale>

@{
    ViewData["Title"] = "Sales & Invoices";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title">Sales & Invoices</h2>
    </div>
    <div class="col-auto">
        <a asp-action="Create" class="btn btn-primary-gradient">
            <i class="bi bi-plus-lg me-1"></i>New Sale
        </a>
    </div>
</div>

<div class="card table-card">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Invoice #</th>
                        <th>Customer</th>
                        <th>Amount</th>
                        <th>Paid</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.SaleDate.ToString("dd MMM yyyy")</td>
                            <td class="fw-bold">@item.InvoiceNumber</td>
                            <td>
                                <div>@item.EndCustomer?.Name</div>
                                <div class="small text-muted">@item.EndCustomer?.PhoneNumber</div>
                            </td>
                            <td>@item.TotalAmount.ToString("C2")</td>
                            <td>@item.PaidAmount.ToString("C2")</td>
                            <td>
                                @if (item.PaymentStatus == TmtInventoryApp.Models.DealerPortal.PaymentStatus.Paid)
                                {
                                    <span class="badge bg-success">Paid</span>
                                }
                                else if (item.PaymentStatus == TmtInventoryApp.Models.DealerPortal.PaymentStatus.Partial)
                                {
                                    <span class="badge bg-warning text-dark">Partial</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Pending</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-eye"></i>
                                </a>
                                @if (item.PaymentStatus != TmtInventoryApp.Models.DealerPortal.PaymentStatus.Paid)
                                {
                                    <a asp-action="RecordPayment" asp-route-id="@item.Id" class="btn btn-sm btn-success-gradient">
                                        <i class="bi bi-cash"></i> Pay
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
