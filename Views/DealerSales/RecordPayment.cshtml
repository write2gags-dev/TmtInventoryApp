@model TmtInventoryApp.Models.DealerPortal.CustomerSale

@{
    ViewData["Title"] = "Record Payment";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
    var sale = ViewBag.Sale as TmtInventoryApp.Models.DealerPortal.CustomerSale;
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title">Record Payment</h2>
        <div class="text-muted">For Invoice #@sale?.InvoiceNumber</div>
    </div>
    <div class="col-auto">
        <a asp-action="Details" asp-route-id="@sale?.Id" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Sale
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card mb-4">
             <div class="card-header bg-light">
                <h5 class="card-title mb-0">Sale Summary</h5>
            </div>
            <div class="card-body">
                <div class="d-flex justify-content-between mb-2">
                    <span>Total Amount:</span>
                    <span class="fw-bold">@sale?.TotalAmount.ToString("C2")</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Already Paid:</span>
                    <span class="text-success">@sale?.PaidAmount.ToString("C2")</span>
                </div>
                 <hr />
                <div class="d-flex justify-content-between mb-0">
                    <span class="fw-bold fs-5">Outstanding:</span>
                    <span class="fw-bold fs-5 text-danger">@sale?.OutstandingAmount.ToString("C2")</span>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-light">
                <h5 class="card-title mb-0">New Payment</h5>
            </div>
            <div class="card-body">
                <form asp-action="RecordPayment">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" name="id" value="@sale?.Id" />

                    <div class="mb-3">
                        <label class="form-label required">Payment Amount</label>
                        <div class="input-group">
                            <span class="input-group-text">₹</span>
                            <input type="number" name="amount" class="form-control" step="0.01" min="0.01" max="@sale?.OutstandingAmount" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label required">Payment Method</label>
                        <select name="paymentMethod" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                            <option value="Cheque">Cheque</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Reference Number</label>
                        <input type="text" name="referenceNumber" class="form-control" placeholder="Transaction ID, Cheque No, etc." />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Notes</label>
                        <textarea name="notes" class="form-control" rows="2"></textarea>
                    </div>

                    <div class="d-grid">
                        <button type="submit" class="btn btn-success-gradient">
                            <i class="bi bi-cash me-2"></i>Record Payment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
