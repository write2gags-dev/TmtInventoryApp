@model TmtInventoryApp.Models.OpeningDealerBalance

@{
    ViewData["Title"] = "Add Opening Balance";
}

<div class="container">
    <div class="row mb-4">
        <div class="col-12">
            <h2><i class="bi bi-plus-circle"></i> Add Opening Dealer Balance</h2>
            <p class="text-muted">Enter historical dealer balance before system implementation</p>
        </div>
    </div>

    <div class="card">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Opening Balance Entry</h5>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DealerId" class="form-label required">Dealer</label>
                        <select asp-for="DealerId" class="form-select" asp-items="ViewBag.DealerId">
                            <option value="">-- Select Dealer --</option>
                        </select>
                        <span asp-validation-for="DealerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TmtVariantId" class="form-label required">TMT Variant / Product</label>
                        <select asp-for="TmtVariantId" class="form-select" asp-items="ViewBag.TmtVariantId">
                            <option value="">-- Select Variant --</option>
                        </select>
                        <span asp-validation-for="TmtVariantId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="OpeningBalanceKg" class="form-label required">Opening Balance (kg)</label>
                        <input asp-for="OpeningBalanceKg" type="number" step="0.01" class="form-control" placeholder="Enter balance in kg" />
                        <div class="form-text">
                            <strong>Positive (+)</strong>: Dealer owes you<br/>
                            <strong>Negative (-)</strong>: You owe dealer
                        </div>
                        <span asp-validation-for="OpeningBalanceKg" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AsOfDate" class="form-label">As of Date</label>
                        <input asp-for="AsOfDate" type="date" class="form-control" />
                        <div class="form-text">Date from which this balance is valid</div>
                        <span asp-validation-for="AsOfDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-12 mb-3">
                        <label asp-for="Notes" class="form-label">Notes (Optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any additional notes or context..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>
                </div>

                <div class="alert alert-info">
                    <h6><i class="bi bi-lightbulb-fill"></i> How to calculate opening balance:</h6>
                    <ul class="mb-0">
                        <li><strong>If dealer owes you:</strong> Enter positive value (e.g., 1000)</li>
                        <li><strong>If you owe dealer:</strong> Enter negative value (e.g., -1000)</li>
                        <li>This balance represents the difference between what you sold vs. what you billed historically</li>
                    </ul>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end mt-4">
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-circle"></i> Save Opening Balance
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
