@model TmtInventoryApp.Models.OpeningDealerBalance

@{
    ViewData["Title"] = "Delete Opening Balance";
}

<div class="container">
    <h2><i class="bi bi-trash"></i> Delete Opening Balance</h2>
    <hr />

    <div class="alert alert-warning">
        <h5><i class="bi bi-exclamation-triangle-fill"></i> Are you sure you want to delete this opening balance?</h5>
        <p class="mb-0">This action cannot be undone.</p>
    </div>

    <div class="card">
        <div class="card-header">
            <h5 class="mb-0">Opening Balance Details</h5>
        </div>
        <div class="card-body">
            <dl class="row">
                <dt class="col-sm-3">Dealer</dt>
                <dd class="col-sm-9">@Model.Dealer?.Name</dd>

                <dt class="col-sm-3">Variant</dt>
                <dd class="col-sm-9">@Model.TmtVariant?.DisplayName</dd>

                <dt class="col-sm-3">Opening Balance</dt>
                <dd class="col-sm-9">
                    <strong class="@(Model.OpeningBalanceKg >= 0 ? "text-success" : "text-danger")">
                        @Model.OpeningBalanceKg.ToString("N2") kg
                    </strong>
                    @if (Model.OpeningBalanceKg > 0)
                    {
                        <span class="badge bg-success">Dealer owes you</span>
                    }
                    else if (Model.OpeningBalanceKg < 0)
                    {
                        <span class="badge bg-danger">You owe dealer</span>
                    }
                </dd>

                <dt class="col-sm-3">As of Date</dt>
                <dd class="col-sm-9">@Model.AsOfDate.ToShortDateString()</dd>

                <dt class="col-sm-3">Notes</dt>
                <dd class="col-sm-9">@(Model.Notes ?? "-")</dd>
            </dl>

            <form asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Confirm Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
