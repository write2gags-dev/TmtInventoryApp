@model TmtInventoryApp.Models.OpeningDealerBalance

@{
    ViewData["Title"] = "Edit Opening Balance";
}

<div class="container">
    <h2><i class="bi bi-pencil"></i> Edit Opening Balance</h2>
    <hr />

    <div class="card">
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="Id" />
                <input type="hidden" asp-for="CreatedDate" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DealerId" class="form-label">Dealer</label>
                        <select asp-for="DealerId" class="form-select" asp-items="ViewBag.DealerId"></select>
                        <span asp-validation-for="DealerId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="TmtVariantId" class="form-label">Variant</label>
                        <select asp-for="TmtVariantId" class="form-select" asp-items="ViewBag.TmtVariantId"></select>
                        <span asp-validation-for="TmtVariantId" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="OpeningBalanceKg" class="form-label">Opening Balance (kg)</label>
                        <input asp-for="OpeningBalanceKg" type="number" step="0.01" class="form-control" />
                        <span asp-validation-for="OpeningBalanceKg" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="AsOfDate" class="form-label">As of Date</label>
                        <input asp-for="AsOfDate" type="date" class="form-control" />
                        <span asp-validation-for="AsOfDate" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Notes" class="form-label">Notes</label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="text-danger"></span>
                </div>

                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
