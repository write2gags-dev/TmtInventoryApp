@model TmtInventoryApp.Models.DealerPortal.ProductBrand

@{
    ViewData["Title"] = "Add New Brand";
    Layout = "~/Views/Shared/_DealerPortalLayout.cshtml";
}

<div class="row align-items-center mb-4">
    <div class="col">
        <h2 class="page-title">Add New @ViewBag.CategoryName Brand</h2>
    </div>
    <div class="col-auto">
        <a asp-action="Brands" asp-route-categoryId="@Model.ProductCategoryId" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to List
        </a>
    </div>
</div>

<div class="card table-card">
    <div class="card-body">
        <div class="row justify-content-center">
            <div class="col-md-8">
                <form asp-action="CreateBrand">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                    <input type="hidden" asp-for="ProductCategoryId" />
                    
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" placeholder="Enter brand name" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3" placeholder="Enter description (optional)"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3 form-check">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </label>
                    </div>

                    <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                        <button type="submit" class="btn btn-primary-gradient">
                            <i class="bi bi-check-lg me-1"></i>Create Brand
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
