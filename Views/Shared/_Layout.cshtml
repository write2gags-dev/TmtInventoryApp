<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TMT Inventory</title>
    @functions {
        public string GetActiveClass(string controller, string? action = null)
        {
            var currentController = ViewContext.RouteData.Values["Controller"] as string;
            var currentAction = ViewContext.RouteData.Values["Action"] as string;

            if (string.IsNullOrEmpty(currentController)) return "";

            bool isControllerMatch = string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase);

            if (action != null)
            {
                bool isActionMatch = string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase);
                return isControllerMatch && isActionMatch ? "active" : "";
            }

            return isControllerMatch ? "active" : "";
        }
    }
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TmtInventoryApp.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">TMT Inventory</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Home")" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Stock")" asp-area="" asp-controller="Stock" asp-action="Index">Manage Stock</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Dealers")" asp-area="" asp-controller="Dealers" asp-action="Index">Dealers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Sales")" asp-area="" asp-controller="Sales" asp-action="Index">Sales</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Billing")" asp-area="" asp-controller="Billing" asp-action="Index">Billing</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Purchase")" asp-area="" asp-controller="Purchase" asp-action="Index">Stock Received</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Reconciliation")" asp-area="" asp-controller="Reconciliation" asp-action="Index">Business Health</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("OpeningBalance")" asp-area="" asp-controller="OpeningBalance" asp-action="Index">Opening Balances</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("ActivityLog")" asp-area="" asp-controller="ActivityLog" asp-action="DailySummary">Activity Log</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link @GetActiveClass("Settings")" asp-area="" asp-controller="Settings" asp-action="Index">Settings</a>
                        </li>
                    </ul>
                    <ul class="navbar-nav ms-auto">
                        @{
                            var displayName = Context.Session.GetString("DisplayName");
                            var role = Context.Session.GetString("Role");
                        }
                        @if (!string.IsNullOrEmpty(displayName))
                        {
                            <li class="nav-item">
                                <span class="nav-link">
                                    <i class="bi bi-person-circle"></i> @displayName
                                    @if (role == "Admin")
                                    {
                                        <span class="badge bg-success">Admin</span>
                                    }
                                </span>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="ChangePassword">
                                    <i class="bi bi-key"></i> Change Password
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Logout">
                                    <i class="bi bi-box-arrow-right"></i> Logout
                                </a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    @TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TMT Inventory - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
