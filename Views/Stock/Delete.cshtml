@model TmtInventoryApp.Models.StockEntry

@{
    ViewData["Title"] = "Delete Stock";
}

<h1>Delete Stock</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Stock Entry</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TmtVariant)
        </dt>
            <dd class = "col-sm-10">
                @((Model.TmtVariant != null && Model.TmtVariant.Diameter > 0) ? Model.TmtVariant.Diameter + " mm" : Model.TmtVariant?.DisplayName)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.QuantityBundles)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.QuantityBundles)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.TotalWeight)
        </dt>
        <dd class = "col-sm-10">
            @Model.TotalWeight.ToString("N2") kg
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </form>
</div>
