@model IEnumerable<TmtInventoryApp.Models.ViewModels.StockHistoryViewModel>

@{
    ViewData["Title"] = "Offline Stock Addition History (12 Months)";
}

<div class="container-fluid fade-in">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-clock-history text-primary"></i> Offline Stock Additions</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left me-2"></i>Back to Stock
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="py-3 ps-4">Date</th>
                            <th class="py-3">Invoice</th>
                            <th class="py-3">Created By</th>
                            <th class="py-3">Items Added</th>
                            <th class="py-3 pe-4 text-end">Total Weight</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">@item.Date.ToString("dd MMM yyyy HH:mm")</td>
                                <td><span class="badge bg-secondary">@item.InvoiceNumber</span></td>
                                <td>@item.UserName</td>
                                <td>
                                    <ul class="list-unstyled mb-0">
                                        @foreach (var detail in item.Items)
                                        {
                                            <li>
                                                <strong>@detail.VariantName</strong>: 
                                                @detail.Bundles Bundles 
                                                <span class="text-muted">(@detail.WeightTons T)</span>
                                            </li>
                                        }
                                    </ul>
                                </td>
                                <td class="pe-4 text-end fw-bold">
                                    @item.Items.Sum(x => x.WeightTons).ToString("0.###") Tons
                                </td>
                            </tr>
                        }
                        @if (!Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5 text-muted">
                                    <i class="bi bi-box-seam fa-3x mb-3 d-block opacity-50" style="font-size: 3rem;"></i>
                                    No offline stock additions found in the last 12 months.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
