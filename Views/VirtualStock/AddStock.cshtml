@model TmtInventoryApp.Models.VirtualStock

@{
    ViewData["Title"] = "Add Stock (GRN)";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h4 class="mb-0"><i class="bi bi-plus-circle"></i> Add Stock (GRN) - @Model.TmtVariant?.DisplayName</h4>
                </div>
                <div class="card-body">
                    <div class="alert alert-info">
                        <i class="bi bi-info-circle"></i> 
                        Adding stock here will increase both <strong>Virtual Stock</strong> and <strong>Physical Stock</strong>.
                    </div>

                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card bg-light">
                                <div class="card-body text-center">
                                    <h6 class="text-muted">Current Virtual Stock</h6>
                                    <h3>@Model.AvailableWeightTons.ToString("N3") <small class="fs-6 text-muted">Tons</small></h3>
                                    <h5>@Model.AvailableBundles <small class="fs-6 text-muted">Bundles</small></h5>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="AddStock">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="control-label fw-bold">Added Weight (Tons)</label>
                                    <input name="addedWeightTons" type="number" step="0.001" class="form-control form-control-lg" required />
                                    <small class="text-muted">Enter the weight received in Tons</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group mb-3">
                                    <label class="control-label fw-bold">Added Bundles</label>
                                    <input name="addedBundles" type="number" class="form-control form-control-lg" required />
                                    <small class="text-muted">Enter the number of bundles received</small>
                                </div>
                            </div>
                        </div>

                        <div class="form-group mb-4">
                            <label class="control-label">Notes / Reference</label>
                            <textarea name="notes" class="form-control" rows="2" placeholder="e.g., GRN #1234 from Shyamsteel"></textarea>
                        </div>

                        <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                            <a asp-action="Index" class="btn btn-secondary me-md-2">Cancel</a>
                            <button type="submit" class="btn btn-success px-4">
                                <i class="bi bi-plus-lg"></i> Add Stock
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
